<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product
      Id="*"
      Name="$(var.AppName)"
      Language="1033"
      Version="$(var.Version)"
      Manufacturer="IntelliAttend"
      UpgradeCode="F4E7A3C8-2D5B-4A9E-8C1D-6F3B7A2E9D0C">

    <Package
        InstallerVersion="200"
        Compressed="yes"
        InstallScope="perUser"
        Platform="x64"
        Description="IntelliAttend SmartBoard Attendance Kiosk"
        Manufacturer="IntelliAttend" />

    <!-- Handle upgrades: uninstall old version, install new version -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of IntelliAttend SmartBoard is already installed." />

    <Media Id="1" Cabinet="product.cab" EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="APPLICATIONFOLDER" Name="$(var.AppName)">

          <!-- App executable and core DLLs -->
          <Component Id="C_App_Core" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
            <File Id="F_exe" Name="$(var.AppName).exe" DiskId="1" Source="$(var.SourceDir)\$(var.AppName).exe" />
            <File Id="F_flutter_windows" Name="flutter_windows.dll" DiskId="1" Source="$(var.SourceDir)\flutter_windows.dll" />
            <File Id="F_isar" Name="isar.dll" DiskId="1" Source="$(var.SourceDir)\isar.dll" />
            <File Id="F_isar_flutter_libs" Name="isar_flutter_libs_plugin.dll" DiskId="1" Source="$(var.SourceDir)\isar_flutter_libs_plugin.dll" />
            <File Id="F_pdfium" Name="pdfium.dll" DiskId="1" Source="$(var.SourceDir)\pdfium.dll" />
            <File Id="F_window_manager" Name="window_manager_plugin.dll" DiskId="1" Source="$(var.SourceDir)\window_manager_plugin.dll" />
            <File Id="F_audioplayers" Name="audioplayers_windows_plugin.dll" DiskId="1" Source="$(var.SourceDir)\audioplayers_windows_plugin.dll" />
            <File Id="F_connectivity" Name="connectivity_plus_plugin.dll" DiskId="1" Source="$(var.SourceDir)\connectivity_plus_plugin.dll" />
            <File Id="F_notifications" Name="flutter_local_notifications_windows.dll" DiskId="1" Source="$(var.SourceDir)\flutter_local_notifications_windows.dll" />
            <File Id="F_secure_storage" Name="flutter_secure_storage_windows_plugin.dll" DiskId="1" Source="$(var.SourceDir)\flutter_secure_storage_windows_plugin.dll" />
            <File Id="F_url_launcher" Name="url_launcher_windows_plugin.dll" DiskId="1" Source="$(var.SourceDir)\url_launcher_windows_plugin.dll" />
            <File Id="F_screen_retriever" Name="screen_retriever_windows_plugin.dll" DiskId="1" Source="$(var.SourceDir)\screen_retriever_windows_plugin.dll" />
            <RegistryValue Root="HKCU" Key="Software\$(var.AppName)\Files" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>

          <!-- Data directory: AOT compiled code, ICU data, and Flutter assets -->
          <Directory Id="DataDir" Name="data">
            <Component Id="C_Data_Files" Guid="C2D3E4F5-A6B7-4890-CDEF-123456789ABC">
              <File Id="F_app_so" Name="app.so" DiskId="1" Source="$(var.SourceDir)\data\app.so" />
              <File Id="F_icudtl" Name="icudtl.dat" DiskId="1" Source="$(var.SourceDir)\data\icudtl.dat" />
              <RegistryValue Root="HKCU" Key="Software\$(var.AppName)\Data" Name="installed" Type="integer" Value="1" KeyPath="yes" />
            </Component>

            <Directory Id="FlutterAssetsDir" Name="flutter_assets">
              <Component Id="C_FlutterAssets" Guid="D3E4F5A6-B7C8-4901-DEF2-3456789ABCDE">
                <File Id="FA_AssetManifest" Name="AssetManifest.bin" DiskId="1" Source="$(var.SourceDir)\data\flutter_assets\AssetManifest.bin" />
                <File Id="FA_FontManifest" Name="FontManifest.json" DiskId="1" Source="$(var.SourceDir)\data\flutter_assets\FontManifest.json" />
                <File Id="FA_NativeAssetsManifest" Name="NativeAssetsManifest.json" DiskId="1" Source="$(var.SourceDir)\data\flutter_assets\NativeAssetsManifest.json" />
                <File Id="FA_NOTICES" Name="NOTICES.Z" DiskId="1" Source="$(var.SourceDir)\data\flutter_assets\NOTICES.Z" />
                <File Id="FA_env" Name=".env" DiskId="1" Source="$(var.SourceDir)\data\flutter_assets\.env" />
                <RegistryValue Root="HKCU" Key="Software\$(var.AppName)\FlutterAssets" Name="installed" Type="integer" Value="1" KeyPath="yes" />
              </Component>

              <Directory Id="FlutterAssetsAssetsDir" Name="assets">
                <Component Id="C_FlutterAssets_Assets" Guid="E4F5A6B7-C8D9-4012-EFAB-456789ABCDEF">
                  <File Id="FA_bg" Name="background.png" DiskId="1" Source="$(var.SourceDir)\data\flutter_assets\assets\background.png" />
                  <File Id="FA_lottie" Name="Errorfailure.lottie" DiskId="1" Source="$(var.SourceDir)\data\flutter_assets\assets\Errorfailure.lottie" />
                  <File Id="FA_logo" Name="logo.png" DiskId="1" Source="$(var.SourceDir)\data\flutter_assets\assets\logo.png" />
                  <File Id="FA_logo_sq" Name="logo_square.png" DiskId="1" Source="$(var.SourceDir)\data\flutter_assets\assets\logo_square.png" />
                  <RegistryValue Root="HKCU" Key="Software\$(var.AppName)\FlutterAssets\Assets" Name="installed" Type="integer" Value="1" KeyPath="yes" />
                </Component>
              </Directory>

              <Directory Id="FlutterAssetsFontsDir" Name="fonts">
                <Component Id="C_FlutterAssets_Fonts" Guid="F5A6B7C8-D9E0-4123-ABCD-56789ABCDEF0">
                  <File Id="FA_font" Name="MaterialIcons-Regular.otf" DiskId="1" Source="$(var.SourceDir)\data\flutter_assets\fonts\MaterialIcons-Regular.otf" />
                  <RegistryValue Root="HKCU" Key="Software\$(var.AppName)\FlutterAssets\Fonts" Name="installed" Type="integer" Value="1" KeyPath="yes" />
                </Component>
              </Directory>

              <Directory Id="FlutterAssetsShadersDir" Name="shaders">
                <Component Id="C_FlutterAssets_Shaders" Guid="A6B7C8D9-E0F1-4234-BCDE-67890ABCDEF1">
                  <File Id="FA_shader1" Name="ink_sparkle.frag" DiskId="1" Source="$(var.SourceDir)\data\flutter_assets\shaders\ink_sparkle.frag" />
                  <File Id="FA_shader2" Name="stretch_effect.frag" DiskId="1" Source="$(var.SourceDir)\data\flutter_assets\shaders\stretch_effect.frag" />
                  <RegistryValue Root="HKCU" Key="Software\$(var.AppName)\FlutterAssets\Shaders" Name="installed" Type="integer" Value="1" KeyPath="yes" />
                </Component>
              </Directory>
            </Directory>
          </Directory>

          <Component Id="C_RemoveFolder" Guid="B1C2D3E4-F5A6-7890-BCDE-123456789012">
            <RemoveFolder Id="RemoveAppFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\$(var.AppName)\Remove" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="IntelliAttend">
          <Component Id="C_StartMenuShortcut" Guid="F6A7B8C9-D0E1-2345-EFAB-678901234567">
            <Shortcut
                Id="StartMenuShortcut"
                Name="$(var.AppName)"
                Description="IntelliAttend SmartBoard"
                Target="[APPLICATIONFOLDER]$(var.AppName).exe"
                WorkingDirectory="APPLICATIONFOLDER" />
            <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
            <RegistryValue
                Root="HKCU"
                Key="Software\Microsoft\$(var.AppName)"
                Name="installed"
                Type="integer"
                Value="1"
                KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <DirectoryRef Id="APPLICATIONFOLDER">
      <Component Id="C_AutoStart" Guid="A7B8C9D0-E1F2-3456-ABCD-789012345678">
        <RegistryValue
            Root="HKCU"
            Key="Software\Microsoft\Windows\CurrentVersion\Run"
            Name="$(var.AppName)"
            Value="&quot;[APPLICATIONFOLDER]$(var.AppName).exe&quot; --intelliattend-autostart"
            Type="string" />
      </Component>
    </DirectoryRef>

    <Feature Id="DefaultFeature" Title="$(var.AppName)" Level="1">
      <ComponentRef Id="C_App_Core" />
      <ComponentRef Id="C_Data_Files" />
      <ComponentRef Id="C_FlutterAssets" />
      <ComponentRef Id="C_FlutterAssets_Assets" />
      <ComponentRef Id="C_FlutterAssets_Fonts" />
      <ComponentRef Id="C_FlutterAssets_Shaders" />
      <ComponentRef Id="C_RemoveFolder" />
      <ComponentRef Id="C_StartMenuShortcut" />
      <ComponentRef Id="C_AutoStart" />
    </Feature>

    <UI>
      <UIRef Id="WixUI_Minimal" />
      <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />
      
      <!-- Auto-launch after install -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Order="9999">1</Publish>
    </UI>

    <!-- Custom action to launch app after install -->
    <CustomAction Id="LaunchApplication" FileKey="F_exe" ExeCommand="" Return="asyncNoWait" />

    <Condition Message="This application requires a 64-bit Windows system.">
      VersionNT64
    </Condition>
  </Product>

</Wix>
