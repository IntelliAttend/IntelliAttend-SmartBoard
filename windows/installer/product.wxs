<?xml version="1.0" encoding="UTF-8"?>
<!--
  IntelliAttend SmartBoard — Windows Installer (WiX Toolset v3)

  Simplified installer that includes only the exe and DLLs.
  Assets are copied by the app on first run.

  Build:
    candle -dAppName="intelliattend_smartboard" -dVersion="1.0.0" -dSourceDir="..\..\build\windows\x64\runner\Release" product.wxs -out product.wixobj
    light -ext WixUIExtension product.wixobj -out "..\..\build\windows\x64\runner\Release\intelliattend_smartboard-$(Version).msi"
-->

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product
      Id="*"
      Name="$(var.AppName)"
      Language="1033"
      Version="$(var.Version)"
      Manufacturer="IntelliAttend"
      UpgradeCode="F4E7A3C8-2D5B-4A9E-8C1D-6F3B7A2E9D0C">

    <Package
        InstallerVersion="200"
        Compressed="yes"
        InstallScope="perUser"
        Platform="x64"
        Description="IntelliAttend SmartBoard Attendance Kiosk"
        Manufacturer="IntelliAttend" />

    <Media Id="1" Cabinet="product.cab" EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="APPLICATIONFOLDER" Name="$(var.AppName)">
          <Component Id="C_App" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
            <File Id="F_exe" Name="$(var.AppName).exe" DiskId="1" Source="$(var.SourceDir)\$(var.AppName).exe" KeyPath="yes" />
            <File Id="F_flutter_windows" Name="flutter_windows.dll" DiskId="1" Source="$(var.SourceDir)\flutter_windows.dll" />
            <File Id="F_isar" Name="isar.dll" DiskId="1" Source="$(var.SourceDir)\isar.dll" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="IntelliAttend">
          <Component Id="C_StartMenuShortcut" Guid="F6A7B8C9-D0E1-2345-EFAB-678901234567">
            <Shortcut
                Id="StartMenuShortcut"
                Name="$(var.AppName)"
                Description="IntelliAttend SmartBoard"
                Target="[APPLICATIONFOLDER]$(var.AppName).exe"
                WorkingDirectory="APPLICATIONFOLDER" />
            <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
            <RegistryValue
                Root="HKCU"
                Key="Software\Microsoft\$(var.AppName)"
                Name="installed"
                Type="integer"
                Value="1"
                KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <DirectoryRef Id="APPLICATIONFOLDER">
      <Component Id="C_AutoStart" Guid="A7B8C9D0-E1F2-3456-ABCD-789012345678">
        <RegistryValue
            Root="HKCU"
            Key="Software\Microsoft\Windows\CurrentVersion\Run"
            Name="$(var.AppName)"
            Value="[APPLICATIONFOLDER]$(var.AppName).exe"
            Type="string" />
      </Component>
    </DirectoryRef>

    <Feature Id="DefaultFeature" Title="$(var.AppName)" Level="1">
      <ComponentRef Id="C_App" />
      <ComponentRef Id="C_StartMenuShortcut" />
      <ComponentRef Id="C_AutoStart" />
    </Feature>

    <UI>
      <UIRef Id="WixUI_Minimal" />
      <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />
    </UI>

    <Condition Message="This application requires a 64-bit Windows system.">
      VersionNT64
    </Condition>
  </Product>

</Wix>
