# IntelliAttend SmartBoard — Environment Template
# Copy to .env and fill in values. DO NOT commit .env to git.

API_BASE_URL=https://api.intelliattend.app
LOCAL_API_URL=http://127.0.0.1:8000/v1/board/telemetry

# Obtain from Firebase Console → Project Settings → General → Your apps
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here

# SSL pinning — SHA-256 fingerprint of server TLS cert (production only)
# SSL_PIN_FINGERPRINT=

ENABLE_DOCUMENTS=true
