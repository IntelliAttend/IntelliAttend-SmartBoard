# IntelliAttend SmartBoard Environment Configuration
# Copy this file to .env and fill in the values

# The base URL for the IntelliAttend Cloud API
# Staging: https://api-dev.balaseetharamanjaneyulu.com
# Production: https://api.intelliattend.com
API_BASE_URL=https://api-dev.balaseetharamanjaneyulu.com

# The local Python "Brain" API for device telemetry
LOCAL_API_URL=http://127.0.0.1:8000/v1/board/telemetry

# Optional: Override server address (if server_override.txt is not used)
# SERVER_OVERRIDE=http://192.168.1.100:8000
