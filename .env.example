# IntelliAttend SmartBoard - Environment Configuration
# API_BASE_URL is the backend URL for local development.
API_BASE_URL=https://api.example.invalid
LOCAL_API_URL=http://127.0.0.1:8000/v1/board/telemetry

# Firebase Configuration
FIREBASE_API_KEY=replace-with-restricted-firebase-api-key
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_APP_ID=replace-with-firebase-app-id
FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-sender-id

# SSL pinning (production only)
SSL_PIN_FINGERPRINT=replace-with-production-certificate-fingerprint

ENABLE_DOCUMENTS=true
DEBUG=false
