# IntelliAttend SmartBoard — Environment Template
# Copy to .env and fill in values. DO NOT commit .env to git.
# In CI/CD, this file is NOT used — values are injected via --dart-define.

# The base URL for the IntelliAttend Cloud API
# This is REQUIRED. The app will fail to start if not set.
API_BASE_URL=https://api.your-production-domain.com

# The local Python "Brain" API for device telemetry
LOCAL_API_URL=http://127.0.0.1:8000/v1/board/telemetry

# Optional: Override server address (if server_override.txt is not used)
# SERVER_OVERRIDE=http://192.168.1.100:8000

# CRITICAL FOR PRODUCTION: SSL Certificate Pinning
# SHA-256 hash of the server's TLS certificate. Prevents MITM attacks
# on the classroom network even if the CA is compromised.
# Generate with:
#   openssl x509 -in cert.pem -outform DER | shasum -a 256 | cut -d' ' -f1
# Leave UNSET in dev (uses default OS trust store).
# SSL_PIN_FINGERPRINT=abc123...

# Firebase Auth REST credentials (used by FirebaseRestAuth — no plugin)
# The kiosk uses ONLY the Identity Toolkit + Secure Token API endpoints.
# Restrict this key in Firebase Console to those two APIs before production.
# Obtain from Firebase Console → Project Settings → General → Your apps
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here

# Ambient video URL for the idle screen background.
# Set to your own CDN URL in production. Defaults to Flutter's demo video.
# AMBIENT_VIDEO_URL=https://cdn.example.com/ambient.mp4

# Enable/disable video background breaks (default: false)
# ENABLE_VIDEO_BREAKS=true

# Enable/disable document sharing — prototyping mode only
# PDF → built-in pdfrx viewer; other files → system default app
ENABLE_DOCUMENTS=true

# Debug mode — MUST be false in production builds.
# When true, verbose logs are written to the filesystem.
DEBUG=false
